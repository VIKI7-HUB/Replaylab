# Tavily API Configuration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_CONCURRENCY=5

# LLM provider (optional, any OpenAI-compatible endpoint). Without it, a conservative
# heuristic verifier runs and abstains when evidence is unclear.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Database & Cache
DATABASE_PATH=stale_detector.db
CACHE_ENABLED=true

# Security (Optional API key for client requests)
API_KEY=
