FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/replaylab ./cmd/replaylab

FROM alpine:3.20
RUN apk --no-cache add ca-certificates wget && adduser -D -u 10001 app && mkdir -p /data && chown app /data
USER app
COPY --from=builder /out/replaylab /usr/local/bin/replaylab
EXPOSE 8085
ENTRYPOINT ["/usr/local/bin/replaylab"]
