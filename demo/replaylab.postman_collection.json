{
  "info": {
    "name": "Bifrost Replay Lab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "experiment_id",
      "value": "exp-replace-me"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/health"
        },
        "description": ""
      }
    },
    {
      "name": "Prometheus metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/metrics"
        },
        "description": ""
      }
    },
    {
      "name": "Capture via proxy",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8085/v1/chat/completions"
        },
        "description": "Forwarded to GATEWAY_URL and captured. Add X-Replaylab-Tag to group traffic.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Extract the structured JSON object containing name, email, and company from: 'Alice at alice@example.com, Acme Corp.'\"\n    }\n  ],\n  \"response_format\": {\n    \"type\": \"json_object\"\n  }\n}"
        }
      }
    },
    {
      "name": "List captures",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/captures?model=gpt-4o&limit=5"
        },
        "description": ""
      }
    },
    {
      "name": "Get config",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/config"
        },
        "description": ""
      }
    },
    {
      "name": "Update config (partial)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8085/replaylab/config"
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sampling_rate\": 0.5\n}"
        }
      }
    },
    {
      "name": "Price book",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/models"
        },
        "description": ""
      }
    },
    {
      "name": "Dry run (cost estimate)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments"
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Estimate\",\n  \"original_model\": \"gpt-4o\",\n  \"candidate_models\": [\n    \"gpt-4o-mini\",\n    \"claude-3-haiku\"\n  ],\n  \"sample_size\": 50,\n  \"dry_run\": true\n}"
        }
      }
    },
    {
      "name": "Start experiment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments"
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cost reduction trial\",\n  \"original_model\": \"gpt-4o\",\n  \"candidate_models\": [\n    \"gpt-4o-mini\",\n    \"claude-3-haiku\",\n    \"meta-llama-3.1-8b\"\n  ],\n  \"sample_size\": 50,\n  \"budget_cap_dollars\": 10.0\n}"
        }
      }
    },
    {
      "name": "List experiments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments?limit=5"
        },
        "description": ""
      }
    },
    {
      "name": "Get experiment",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments/{{experiment_id}}"
        },
        "description": ""
      }
    },
    {
      "name": "Live progress (SSE)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments/{{experiment_id}}/events"
        },
        "description": ""
      }
    },
    {
      "name": "Markdown report",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments/{{experiment_id}}/report?format=markdown"
        },
        "description": ""
      }
    },
    {
      "name": "Cancel experiment",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/replaylab/experiments/{{experiment_id}}/cancel"
        },
        "description": ""
      }
    }
  ]
}