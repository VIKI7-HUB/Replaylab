{
  "info": {
    "name": "Stale-Answer Detector API",
    "description": "Postman collection for testing the Stale-Answer Detector (Tavily Track, Port 8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/v1/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["v1", "health"]
        }
      }
    },
    {
      "name": "2. Check Answer for Stale Facts (Live Audit)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What does GPT-4 cost and who runs Twitter?\",\n  \"answer\": \"OpenAI's flagship model GPT-4 costs $0.03 per 1K input tokens and $0.06 per 1K output tokens. The Chief Executive Officer of Twitter is Elon Musk. In 1969 humans landed on the Moon.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/v1/check",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["v1", "check"]
        }
      }
    },
    {
      "name": "3. Check Answer Streaming (SSE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answer\": \"Python 3.9 is the latest stable release of the Python programming language.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/v1/check/stream",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["v1", "check", "stream"]
        }
      }
    },
    {
      "name": "4. Wrap Question and Model Answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is the flagship model of Anthropic?\",\n  \"model_answer\": \"Anthropic premier model is Claude 2 available at $8.00 per million input tokens.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/v1/wrap",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["v1", "wrap"]
        }
      }
    },
    {
      "name": "5. List Audit History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/v1/history?limit=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["v1", "history"],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    }
  ]
}
