{
  "name": "llm-reliability-insights",
  "version": "1.0.0",
  "private": true,
  "description": "Read-optimized PostgreSQL copy of Replay Lab and the Stale-Answer Detector, with its sync worker and the Insights API.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx main.ts migrate",
    "sync": "tsx main.ts sync",
    "api": "tsx main.ts api",
    "dev": "tsx main.ts all",
    "start": "node dist/main.js all",
    "seed": "tsx bench/seed.ts",
    "bench": "tsx bench/bench.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "fastify": "^5.12.8",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
