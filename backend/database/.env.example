# Copy to .env (git-ignored). Every value has a working local default.

# Postgres. Compose builds this from POSTGRES_PASSWORD; set it yourself when
# running outside compose or against a managed database.
DATABASE_URL=postgres://insights:insights@localhost:5432/insights
# disable | prefer | require (managed Postgres reached over the internet: require)
DATABASE_SSL=prefer
POSTGRES_PASSWORD=insights

# The two services this database copies (HTTP only, never their SQLite files).
REPLAYLAB_URL=http://localhost:8086
STALE_URL=http://localhost:8000
# Only if the Stale-Answer Detector has API_KEY set.
STALE_API_KEY=

SYNC_INTERVAL_MS=5000
API_PORT=8090
