# The mock OpenAI-compatible provider, as an image. Used by the gateway demo
# (loadable/compose.yml), which CI runs; keep it.
FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mockprovider ./cmd/mockprovider

FROM alpine:3.20
RUN apk --no-cache add ca-certificates wget && adduser -D -u 10001 app && mkdir -p /data && chown app /data
USER app
COPY --from=builder /out/mockprovider /usr/local/bin/mockprovider
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/mockprovider"]
