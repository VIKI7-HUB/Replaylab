# One console serves both products. Every VITE_ value ends up in the browser
# bundle, so none of them may hold a secret.

# Replay Lab API (cmd/replaylab -port=8086, or the gateway that loads the plugin).
VITE_REPLAYLAB_URL=http://localhost:8086

# Stale-Answer Detector API.
# In development, leave VITE_STALE_API_URL empty: calls go to /v1 on the dev
# server, which proxies them to STALE_BACKEND_URL and adds STALE_API_KEY.
# A deployed console has no proxy: set VITE_STALE_API_URL to the service URL.
VITE_STALE_API_URL=
STALE_BACKEND_URL=http://localhost:8001
STALE_API_KEY=
# The same service as the browser reaches it, for its health dot.
VITE_STALE_URL=http://localhost:8001

# Insights read API (optional; search and history search need it).
VITE_INSIGHTS_URL=
