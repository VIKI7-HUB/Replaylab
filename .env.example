# Replay Lab API this console calls (cmd/replaylab -port=8086, or APIListenAddr when embedded in Bifrost).
VITE_REPLAYLAB_URL=http://localhost:8086
# Stale-Answer Detector API, used only for its health dot in the top bar.
VITE_STALE_URL=http://localhost:8000
# Insights read API (optional; search needs it).
VITE_INSIGHTS_URL=http://localhost:8090
# Where the Stale-Answer Detector console runs, for its links in the sidebar.
VITE_STALE_CONSOLE_URL=http://localhost:3001
